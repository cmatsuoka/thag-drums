{
  "name": "libhive-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser recreation of a vintage analog percussion unit, powered by libhive",
  "license": "MIT",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "vite",
    "dev:secure": "vite --host --mode secure",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "e2e": "node scripts/e2e-test.mjs"
  },
  "devDependencies": {
    "@types/webmidi": "^2.1.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "playwright-core": "^1.58.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
